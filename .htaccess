# Mastermind Abacus Odisha - Server Configuration for Apache / LiteSpeed (Hostinger)

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Canonical Redirection: www to non-www
RewriteCond %{HTTP_HOST} ^www\.mastermindabacusodisha\.com$ [NC]
RewriteRule ^(.*)$ https://mastermindabacusodisha.com/$1 [L,R=301]
</IfModule>

# Security Headers & HSTS
<IfModule mod_headers.c>
# HTTP Strict Transport Security (HSTS) - 1 Year
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 month"
ExpiresByType text/html "access plus 1 hour"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType text/plain "access plus 1 day"
</IfModule>
